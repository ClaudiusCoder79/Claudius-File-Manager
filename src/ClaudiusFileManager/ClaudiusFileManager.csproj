<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>ClaudiusFileManager</AssemblyName>
    <RootNamespace>ClaudiusFileManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Product>Claudius File Manager</Product>
    <Title>Claudius File Manager</Title>
    <Description>Dual-pane file manager for Windows (freeware)</Description>
    <Company>Michal Czapla &amp; Claude AI</Company>
    <Authors>Michal Czapla &amp; Claude AI</Authors>
    <Copyright>Freeware · Created by Michal Czapla &amp; Claude AI</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown instantly while the app starts -->
    <SplashScreen Include="Assets\splash.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <!-- Translation files: Languages\en.json, pl.json, de.json, fr.json, it.json, es.json -->
    <EmbeddedResource Include="Languages\*.json" />
  </ItemGroup>

</Project>
