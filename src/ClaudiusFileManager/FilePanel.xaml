<UserControl x:Class="ClaudiusFileManager.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Shadow lives on its own layer so the list text keeps ClearType -->
        <Border CornerRadius="14" Background="{DynamicResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.08"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="14" BorderThickness="1.5" Background="Transparent"
                BorderBrush="{DynamicResource SeparatorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drive buttons -->
                <ItemsControl x:Name="DriveList" Grid.Row="0" Margin="12,12,12,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DriveChip}" Click="Drive_Click" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Back / Up / large title -->
                <Grid Grid.Row="1" Margin="8,2,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Padding="8,6"
                            Click="Back_Click" ToolTip="{DynamicResource L.TipBack}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="16"/>
                    </Button>
                    <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource ToolButton}" Padding="8,6"
                            Click="Up_Click" ToolTip="{DynamicResource L.TipUp}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="16"/>
                    </Button>
                    <TextBlock x:Name="TitleText" Grid.Column="2" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource LabelBrush}"
                               Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Path + search -->
                <Grid Grid.Row="2" Margin="12,8,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Style="{StaticResource IosTextBox}" Tag="{DynamicResource L.Path}"
                             PreviewKeyDown="PathBox_PreviewKeyDown"/>
                    <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource IosTextBox}"
                             Tag="{DynamicResource L.Search}"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Grid>

                <!-- Column headers -->
                <Grid Grid.Row="3" Margin="16,12,26,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="124"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HdrName" Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Name" Click="Header_Click"/>
                    <Button x:Name="HdrExt" Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Ext" Click="Header_Click"/>
                    <Button x:Name="HdrSize" Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="Size" Click="Header_Click"
                            HorizontalContentAlignment="Right" Margin="0,0,12,0"/>
                    <Button x:Name="HdrDate" Grid.Column="4" Style="{StaticResource HeaderButton}" Tag="Date" Click="Header_Click"/>
                </Grid>
                <Border Grid.Row="3" VerticalAlignment="Bottom" Height="1" Margin="14,0"
                        Background="{DynamicResource SeparatorBrush}"/>

                <!-- The file list -->
                <ListBox x:Name="FileList" Grid.Row="4" Margin="0,4" Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended" ItemContainerStyle="{StaticResource FileRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         TextSearch.TextPath="DisplayName" IsTextSearchEnabled="True"
                         KeyboardNavigation.TabNavigation="None" AllowDrop="True"
                         PreviewKeyDown="FileList_PreviewKeyDown"
                         MouseDoubleClick="FileList_MouseDoubleClick"
                         SelectionChanged="FileList_SelectionChanged"
                         PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="FileList_PreviewMouseMove"
                         DragOver="FileList_DragOver" Drop="FileList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="28" Opacity="{Binding RowOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="124"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{Binding IconBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Ext}" FontSize="12" Opacity="0.55"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" Opacity="0.55"
                                           HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding DateText}" FontSize="12" Opacity="0.55"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource L.Open}" Tag="open" Click="Ctx_Click" InputGestureText="Enter">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.View}" Tag="view" Click="Ctx_Click" InputGestureText="F3">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE7B3;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Edit}" Tag="edit" Click="Ctx_Click" InputGestureText="F4">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource L.CtxCopyTo}" Tag="copy" Click="Ctx_Click" InputGestureText="F5">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.CtxMoveTo}" Tag="move" Click="Ctx_Click" InputGestureText="F6">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8DE;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Zip}" Tag="pack" Click="Ctx_Click" InputGestureText="Alt+F5">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Unzip}" Tag="unpack" Click="Ctx_Click" InputGestureText="Alt+F9">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8DA;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Rename}" Tag="rename" Click="Ctx_Click" InputGestureText="F2">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource L.Copy}" Tag="clipcopy" Click="Ctx_Click" InputGestureText="Ctrl+C">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Cut}" Tag="clipcut" Click="Ctx_Click" InputGestureText="Ctrl+X">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Paste}" Tag="paste" Click="Ctx_Click" InputGestureText="Ctrl+V">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.CopyPath}" Tag="copypath" Click="Ctx_Click" InputGestureText="Ctrl+Shift+C">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource L.CtxExplorer}" Tag="explorer" Click="Ctx_Click" InputGestureText="Ctrl+E">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xEC50;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.CtxTerminal}" Tag="terminal" Click="Ctx_Click" InputGestureText="Ctrl+T">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE756;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource L.Properties}" Tag="properties" Click="Ctx_Click" InputGestureText="Alt+Enter">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource L.Delete}" Tag="delete" Click="Ctx_Click" InputGestureText="F8"
                                      Foreground="{DynamicResource RedBrush}">
                                <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- Status bar -->
                <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}"
                        Padding="16,8">
                    <DockPanel>
                        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" FontSize="12"
                                   Foreground="{DynamicResource SecondaryLabelBrush}"/>
                        <TextBlock x:Name="StatusLeft" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryLabelBrush}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
