<UserControl x:Class="ClaudiusFileManager.NavPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One row of the navigation pane (a real Button, so clicks always register) -->
        <Style x:Key="NavRow" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4" Margin="4,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillPressedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClickable}" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="14" Background="{DynamicResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.08"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="14" BorderThickness="1.5" BorderBrush="{DynamicResource SeparatorBrush}" Padding="0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="Items" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Height="1" Margin="14,6" Background="{DynamicResource SeparatorBrush}"
                                        Visibility="{Binding LineVisibility}"/>
                                <Button Style="{StaticResource NavRow}" Click="Item_Click" ToolTip="{Binding Tooltip}"
                                        Visibility="{Binding RowVisibility}">
                                    <Grid Margin="{Binding IndentMargin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryLabelBrush}"/>
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="&#xE718;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="11" Margin="6,0,2,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryLabelBrush}"
                                                   Visibility="{Binding PinVisibility}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
