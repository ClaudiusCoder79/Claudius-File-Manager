<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colours. Every brush the app uses is defined here and referenced with DynamicResource. -->
    <SolidColorBrush x:Key="BgBrush" Color="#161618"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#1F1F22"/>
    <SolidColorBrush x:Key="RibbonBrush" Color="#26262A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1E1E21"/>
    <SolidColorBrush x:Key="FillBrush" Color="#767680" Opacity="0.24"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#767680" Opacity="0.34"/>
    <SolidColorBrush x:Key="FillPressedBrush" Color="#767680" Opacity="0.46"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#38383C"/>
    <SolidColorBrush x:Key="LabelBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="SecondaryLabelBrush" Color="#98989F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#0A84FF" Opacity="0.26"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF453A"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#30D158"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="InactiveSelectionBrush" Color="#333338"/>
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#2C2C30"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#2C2C30"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#2C2C30"/>
    <SolidColorBrush x:Key="DialogTextBrush" Color="#D1D1D6"/>
    <SolidColorBrush x:Key="DialogSeparatorBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#5A5A60"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#7A7A82"/>
    <SolidColorBrush x:Key="TooltipBrush" Color="#F0E5E5EA"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="FKeyBrush" Color="#26262A"/>
    <SolidColorBrush x:Key="FKeyHoverBrush" Color="#333338"/>
    <SolidColorBrush x:Key="FKeyPressedBrush" Color="#404046"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#26FFFFFF"/>
</ResourceDictionary>
