<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme colours. Every brush the app uses is defined here and referenced with DynamicResource. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F3F5"/>
    <SolidColorBrush x:Key="RibbonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FillBrush" Color="#767680" Opacity="0.12"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#767680" Opacity="0.20"/>
    <SolidColorBrush x:Key="FillPressedBrush" Color="#767680" Opacity="0.30"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="LabelBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SecondaryLabelBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#007AFF" Opacity="0.14"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="InactiveSelectionBrush" Color="#EBEBF0"/>
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#FCFCFD"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#F7F7F8"/>
    <SolidColorBrush x:Key="DialogTextBrush" Color="#3C3C43"/>
    <SolidColorBrush x:Key="DialogSeparatorBrush" Color="#333C3C43"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#C7C7CC"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#A1A1A8"/>
    <SolidColorBrush x:Key="TooltipBrush" Color="#E6303036"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FKeyBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FKeyHoverBrush" Color="#E9E9EE"/>
    <SolidColorBrush x:Key="FKeyPressedBrush" Color="#D1D1D6"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#1F000000"/>
</ResourceDictionary>
